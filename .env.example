# ==============================================================================
# SMP NEGERI 14 SURABAYA — ENVIRONMENT CONFIGURATION TEMPLATE
# Panduan Deployment Server Produksi (aaPanel / Nginx / PHP 8.2+)
# ==============================================================================

# Identitas Aplikasi
APP_NAME="SMP Negeri 14 Surabaya"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://smpn14surabaya.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Konfigurasi Database (MySQL / MariaDB aaPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smpn14_surabaya
DB_USERNAME=smpn14_user
DB_PASSWORD=GantiDenganPasswordKuatAnda
DB_COLLATION=utf8mb4_unicode_ci

# Sesi & Penyimpanan File
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# Cache (Gunakan 'database' atau 'redis' untuk optimasi kecepatan respon)
CACHE_STORE=database
CACHE_PREFIX=smpn14_cache_

# Konfigurasi Email Notifikasi (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=info@smpn14surabaya.sch.id
MAIL_PASSWORD=GantiDenganAppPasswordSmtp
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@smpn14surabaya.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Build
VITE_APP_NAME="${APP_NAME}"

# ==============================================================================
# CATATAN POST-DEPLOYMENT DI AAPANEL:
# 1. Pastikan ekstensi PHP terpasang: fileinfo, gd, imagick, pdo_mysql, intl, bcmath, zip
# 2. Jalankan perintah:
#    cp .env.example .env
#    composer install --no-dev --optimize-autoloader
#    php artisan key:generate
#    php artisan migrate --force
#    php artisan storage:link
#    php artisan optimize
# 3. Atur Document Root Nginx mengarah ke: /www/wwwroot/domain-anda/public
# ==============================================================================
